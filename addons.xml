<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.notoco.univ19" name="Notoco Univ Repo" version="3.3" provider-name="notoco">
        <extension point="xbmc.addon.repository" name="Notoco Univ Repo">
            <dir minversion="18.9.0">
                <info>https://github.com/notoco/univk19/raw/master/addons.xml</info>
                <checksum>https://github.com/notoco/univk19/raw/master/addons.xml.md5</checksum>
                <datadir zip="true">https://github.com/notoco/univk19/raw/master/zip</datadir>
            </dir>
            <!-- builds for one Kodi version (Notoco TV): Kodi 21 Omega, Kodi 22 (21.90.x) -->
            <dir minversion="21.0.0" maxversion="21.89.0">
                <info>https://github.com/notoco/univk19/raw/master/kodi21/addons.xml</info>
                <checksum>https://github.com/notoco/univk19/raw/master/kodi21/addons.xml.md5</checksum>
                <datadir zip="true">https://github.com/notoco/univk19/raw/master/kodi21/zip</datadir>
            </dir>
            <dir minversion="21.90.0">
                <info>https://github.com/notoco/univk19/raw/master/kodi22/addons.xml</info>
                <checksum>https://github.com/notoco/univk19/raw/master/kodi22/addons.xml.md5</checksum>
                <datadir zip="true">https://github.com/notoco/univk19/raw/master/kodi22/zip</datadir>
            </dir>
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/repo/zips/</datadir>
        </dir>
        <dir minversion="19.9.1">
            <info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/nexusrepo/zips/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/nexusrepo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/nexusrepo/zips/</datadir>
        </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary>Notoco Univ Repo</summary>
            <description>Prywatne repozytorium notoco</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
<addon id="script.notoco.helper" name="pomocnik notoco" version="3.6.4" provider-name="notoco">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="addon.py">
        <reuselanguageinvoker>true</reuselanguageinvoker>
    </extension>
    <extension point="xbmc.service" library="autoexec.py" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en">Pomocne skróty</summary>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
<addon id="script.audio.profiles" name="Audio Profiles" version="2.3.1" provider-name="pkscout, notoco, Regss">
	<requires>
        <import addon="xbmc.python" version="3.0.0" />
	</requires>
	<extension point="xbmc.python.script" library="default.py"/>
	<extension point="xbmc.service" library="service.py" />
	<extension point="xbmc.addon.metadata">
		<news>
v.2.3.1
- no Kodi objects left alive after a manual run (no "left several classes in memory" warning)
v.2.3.0
- only settings that differ from the profile are written (one audio reopen instead of several)
- automatic switch on Player.OnAVStart instead of a fixed wait after Player.OnPlay
- DTS (dca) and DTS-HD (dtshd_ma/hra) codecs recognised
- events handled outside the notification callback
		</news>
		<assets>
			<icon>icon.png</icon>
		</assets>
		<summary lang="en_GB">Save audio profile and easily switch between them.</summary>
		<summary lang="es_AR">Guarde el perfil de audio y cambie fácilmente entre ellos.</summary>
		<summary lang="es_ES">Guarde el perfil de audio y cambie fácilmente entre ellos.</summary>
		<summary lang="es_MX">Guarde el perfil de audio y cambie fácilmente entre ellos.</summary>
		<summary lang="hu_HU">Hangbeállítások profilba mentése, és könnyű váltás közöttük.</summary>
		<summary lang="it_IT">Salva il profilo audio e cambia facilmente da uno all'altro.</summary>
		<summary lang="pl_PL">Zapisuje profile ustawień audio i łatwo przełącza między nimi.</summary>
