<?xml version="1.0" encoding="UTF-8"?>
<!-- Shown by the service while a TV channel switches -->
<window type="dialog">
    <controls>
        <control type="image">
            <right>48</right>
            <top>48</top>
            <width>48</width>
            <height>48</height>
            <texture>notoco-spinner.png</texture>
            <animation effect="rotate" start="0" end="-360" center="auto" time="1000" loop="true" condition="true">Conditional</animation>
        </control>
    </controls>
</window>
