<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon
  id="pvr.notoco.tv"
  version="1.1.4"
  name="Notoco TV"
  provider-name="notoco">
  <requires>
<import addon="kodi.binary.global.main" minversion="2.0.3" version="2.0.4"/>
<import addon="kodi.binary.global.general" minversion="1.0.4" version="1.0.6"/>
<import addon="kodi.binary.global.gui" minversion="5.15.0" version="5.15.1"/>
<import addon="kodi.binary.global.filesystem" minversion="1.1.11" version="1.1.11"/>
<import addon="kodi.binary.instance.pvr" minversion="9.2.0" version="9.2.0"/>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="tools.ffmpeg-tools" version="1.0.0"/>
    <!-- CoreELEC only: this add-on exists nowhere else -->
    <import addon="service.coreelec.settings" version="1.0.0"/>
  </requires>
  <extension
    point="kodi.pvrclient"
    library_linux="pvr.notoco.tv.so.1.1.4"/>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>linux-aarch64</platform>
    <license>GPL-2.0-or-later</license>
    <summary lang="en_GB">TV client for a Flussonic IPTV list</summary>
    <summary lang="pl_PL">Klient TV dla listy IPTV z serwera Flussonic</summary>
    <description lang="en_GB">Live TV, a seekable archive and recordings from the archive. The add-on reads the streams itself, so a channel switch takes a fraction of a second.</description>
    <description lang="pl_PL">Telewizja na żywo, archiwum z przewijaniem i nagrania z archiwum. Dodatek sam czyta strumienie, więc zmiana kanału trwa ułamek sekundy.</description>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
</addons>
